# Ksat local Compose configuration. These values are fake and local-only.
COMPOSE_PROJECT_NAME=ksat

# Published ports
WEB_PORT=8080
API_PORT=3000
MAILPIT_HTTP_PORT=8025
MAILPIT_SMTP_PORT=1025
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# PostgreSQL
POSTGRES_DB=ksat
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/ksat

# Redis
REDIS_URL=redis://redis:6379

# MinIO / S3-compatible object storage
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minio123
MINIO_BUCKET=ksat
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=ksat
S3_ACCESS_KEY_ID=minio
S3_SECRET_ACCESS_KEY=minio123
S3_FORCE_PATH_STYLE=true

# API process
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
TRUST_PROXY=true
LOG_LEVEL=info
HEALTH_CHECK_TIMEOUT_MS=2000
SHUTDOWN_TIMEOUT_MS=10000

# Local mail delivery (used by later invitation slices)
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=Ksat <no-reply@ksat.local>

# Better Auth identity configuration. Use a unique high-entropy secret in production.
# BETTER_AUTH_URL is the public origin; the handler is mounted at /api/v1/auth.
BETTER_AUTH_URL=http://localhost:8080
BETTER_AUTH_SECRET=dev-only-ksat-better-auth-secret-change-me-1234
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:8080,http://localhost:5173
# Reserved for the future social-provider slice; no provider flow is enabled yet.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Reserved attachment limits for the task-detail slice.
ATTACHMENT_MAX_FILE_BYTES=10485760
ATTACHMENT_MAX_TASK_BYTES=52428800
