# Ksat local Compose configuration. These values are fake and local-only.
COMPOSE_PROJECT_NAME=ksat
WEB_PORT=8080
API_PORT=3000
POSTGRES_PORT=5432
REDIS_PORT=6379
MAILPIT_HTTP_PORT=8025
MAILPIT_SMTP_PORT=1025
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
POSTGRES_DB=ksat
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/ksat
REDIS_URL=redis://redis:6379
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minio123
MINIO_BUCKET=ksat
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=ksat
S3_ACCESS_KEY_ID=minio
S3_SECRET_ACCESS_KEY=minio123
S3_FORCE_PATH_STYLE=true
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
TRUST_PROXY=true
LOG_LEVEL=info
HEALTH_CHECK_TIMEOUT_MS=2000
SHUTDOWN_TIMEOUT_MS=10000
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Ksat <no-reply@ksat.local>
APP_PUBLIC_URL=http://localhost:8080
INVITATION_TTL_HOURS=168
SEED_DEMO_DATA=true
ALLOW_PRODUCTION_DEMO_SEED=false
BETTER_AUTH_URL=http://localhost:8080
BETTER_AUTH_SECRET=local-compose-only-identity-secret-change-before-deploying
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:8080,http://localhost:5173
BETTER_AUTH_SECURE_COOKIES=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ATTACHMENT_MAX_FILE_BYTES=10485760
ATTACHMENT_MAX_TASK_BYTES=52428800
