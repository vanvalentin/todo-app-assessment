NODE_ENV=development
PORT=3000
HOST=0.0.0.0
TRUST_PROXY=false
LOG_LEVEL=info
HEALTH_CHECK_TIMEOUT_MS=2000
SHUTDOWN_TIMEOUT_MS=10000
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/ksat
REDIS_URL=redis://127.0.0.1:6379
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=ksat
S3_ACCESS_KEY_ID=minio
S3_SECRET_ACCESS_KEY=minio123
S3_FORCE_PATH_STYLE=true

# Public origin, not the handler path. The handler is /api/v1/auth.
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=dev-only-ksat-better-auth-secret-change-me-1234
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:5173

# Reserved for the future social-provider slice; no provider flow is enabled yet.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
