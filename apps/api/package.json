{
  "name": "@ksat/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prebuild": "pnpm --filter @ksat/contracts build && prisma generate --schema prisma/schema.prisma",
    "build": "tsc -p tsconfig.json",
    "predev": "pnpm --filter @ksat/contracts build && prisma generate --schema prisma/schema.prisma",
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "node dist/src/server.js",
    "worker": "node dist/src/worker.js",
    "pretest": "prisma generate --schema prisma/schema.prisma",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "pretypecheck": "pnpm --filter @ksat/contracts build && prisma generate --schema prisma/schema.prisma",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "db:migrate": "prisma migrate deploy --schema prisma/schema.prisma",
    "db:migrate:deploy": "prisma migrate deploy --schema prisma/schema.prisma",
    "db:seed": "node dist/src/seed.js",
    "db:seed:dev": "tsx --env-file-if-exists=.env src/seed.ts",
    "db:migrate:diff": "node scripts/check-migration-diff.mjs"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "7.3.4",
    "@aws-sdk/client-s3": "3.821.0",
    "@ksat/contracts": "workspace:0.1.0",
    "@node-rs/argon2": "2.2.1",
    "@prisma/client": "6.7.0",
    "better-auth": "1.7.5",
    "express": "5.1.0",
    "ioredis": "5.6.1",
    "nodemailer": "10.0.10",
    "pino": "9.7.0",
    "pino-http": "10.4.0",
    "swagger-ui-express": "5.0.1",
    "uuid": "11.1.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/express": "5.0.3",
    "@types/node": "24.0.0",
    "@types/nodemailer": "6.4.17",
    "@types/supertest": "6.0.3",
    "@types/swagger-ui-express": "4.1.8",
    "pino-pretty": "13.0.0",
    "prisma": "6.7.0",
    "supertest": "7.2.2",
    "tsx": "4.19.3",
    "typescript": "5.8.3",
    "vitest": "3.2.7"
  }
}
