{
  "name": "@ksat/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prebuild": "pnpm --filter @ksat/contracts build && prisma generate --schema prisma/schema.prisma",
    "build": "tsc -p tsconfig.json",
    "predev": "pnpm --filter @ksat/contracts build && prisma generate --schema prisma/schema.prisma",
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "node dist/src/server.js",
    "worker": "node dist/src/worker.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "pretypecheck": "pnpm --filter @ksat/contracts build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "db:migrate": "prisma migrate deploy --schema prisma/schema.prisma",
    "db:migrate:deploy": "prisma migrate deploy --schema prisma/schema.prisma"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.821.0",
    "@ksat/contracts": "workspace:0.1.0",
    "@node-rs/argon2": "2.0.2",
    "@prisma/client": "6.7.0",
    "better-auth": "1.2.12",
    "express": "5.1.0",
    "ioredis": "5.6.1",
    "pino": "9.7.0",
    "pino-http": "10.4.0",
    "uuid": "11.1.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/express": "5.0.3",
    "@types/node": "24.0.0",
    "@types/supertest": "6.0.3",
    "prisma": "6.7.0",
    "supertest": "7.2.2",
    "tsx": "4.19.3",
    "typescript": "5.8.3",
    "vitest": "3.2.4"
  }
}
